{
  "name": "Query LENR Papers via Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "query-papers",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "query-papers"
    },
    {
      "parameters": {
        "url": "=http://lenr-api:8000/papers",
        "method": "GET",
        "qs": {
          "parameters": [
            {
              "name": "author",
              "value": "={{ $json.body.author }}"
            },
            {
              "name": "title",
              "value": "={{ $json.body.title }}"
            },
            {
              "name": "min_score",
              "value": "={{ $json.body.min_score }}"
            },
            {
              "name": "source",
              "value": "={{ $json.body.source }}"
            },
            {
              "name": "limit",
              "value": "={{ $json.body.limit || 100 }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Query API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [690, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Query API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
